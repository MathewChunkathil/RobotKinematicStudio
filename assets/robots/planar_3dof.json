  "links": [
    { "id": "l0", "index": 0, "name": "Link 1 (400mm)", "visual": { "length": 0.40, "width": 0.04, "height": 0.04 } },
    { "id": "l1", "index": 1, "name": "Link 2 (300mm)", "visual": { "length": 0.30, "width": 0.035,"height": 0.035 } },
